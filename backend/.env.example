APP_NAME=Automation Platform API
APP_VERSION=0.3.0
ENVIRONMENT=development
# Paths are relative to the repository root.
DATABASE_URL=sqlite:///data/automation_platform.db
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
COOKIE_SECURE=false
SESSION_HOURS=8
MAX_ATTEMPTS=3
EXECUTION_TIMEOUT_SECONDS=300
WORKER_POLL_SECONDS=1
# Opt-in real local executors. Install extras first; leave disabled for simulation.
LOCAL_RUNNER_ENABLED=false
BROWSER_HEADLESS=true
LOCAL_ALLOWED_HOSTS=[]
# SOL pilot, only when you authorize a real browser run:
# LOCAL_ALLOWED_HOSTS=["sol.pucgoias.edu.br"]
# AUTOMATION_SECRET_SOL_PASSWORD belongs in the worker process environment.
ARTIFACT_RETENTION_HOURS=24
# Configure secrets locally, never commit their values.
POWER_AUTOMATE_URL=
POWER_AUTOMATE_TOKEN=
POWER_AUTOMATE_CALLBACK_SECRET=
POWER_AUTOMATE_IDEMPOTENT=false
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Credential references resolve AUTOMATION_SECRET_<NAME> in the worker environment.
